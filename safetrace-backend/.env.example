# Copiar como .env y completar. Nunca subir .env a git.
ENTORNO=local

# MongoDB: Atlas (recomendado, ya trae transacciones) o MongoDB Community instalado en el equipo.
#   Atlas:  mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#   Local:  mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=safetrace
MONGO_MAX_POOL_SIZE=20
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=15000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000


# Secreto para JWT (generar uno seguro, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_ALGORITHM=HS256
# Duración máxima del token; además la sesión se cierra tras MINUTOS_SESION sin actividad (RNF-11)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
MINUTOS_SESION=30
MINUTOS_RENOVACION_SESION=1
MINUTOS_TAREA_ATASCADA=15
SEGUNDOS_MAXIMOS_TAREA=300
FALLOS_MAXIMOS_PROVEEDOR=5
SEGUNDOS_CIRCUITO_ABIERTO=60

# n8n llama a /interno/* con el encabezado X-Credencial-Servicio
CREDENCIAL_SERVICIO_N8N=

# Primer administrador general: lo crea `python -m db.semillas`
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Superadministrador (todos los permisos, gestiona roles, módulos y permisos): lo crea `python -m db.semillas`
SUPERADMIN_CORREO=
SUPERADMIN_CONTRASENA=

# Proveedor de archivos compatible con S3. Vacío: la subida y la lectura de archivos responden 501.
#   Cloudflare R2: PROVEEDOR_ARCHIVOS_URL=https://<id-cuenta>.r2.cloudflarestorage.com  ARCHIVOS_REGION=auto
#   MinIO local:   PROVEEDOR_ARCHIVOS_URL=http://localhost:9000                        ARCHIVOS_REGION=us-east-1
#   AWS S3:        PROVEEDOR_ARCHIVOS_URL=https://s3.<region>.amazonaws.com            ARCHIVOS_REGION=<region>
# El bucket debe permitir CORS (PUT y GET) desde el origen del frontend.
PROVEEDOR_ARCHIVOS_URL=
ARCHIVOS_BUCKET=
ARCHIVOS_ACCESS_KEY=
ARCHIVOS_SECRET_KEY=
ARCHIVOS_REGION=auto
ARCHIVOS_TAMANO_MAXIMO_MB=10
ARCHIVOS_SEGUNDOS_SUBIDA=600
ARCHIVOS_SEGUNDOS_LECTURA=900
ARCHIVOS_SEGUNDOS_TIMEOUT=20

# Correo (vacío en local: se simula)
CORREO_API_KEY=
